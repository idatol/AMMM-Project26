int N = ...;
int L = ...;
int U = ...;
int T = ...;
range I = 1..N;
int P[I] = ...;
int E[I] = ...;
 
 dvar boolean x[I];
 dvar boolean s[I];

 minimize sum(i in I) E[i]*x[i];
 
 subject to {
   sum(i in I) P[i]*x[i] >= T;
   
   s[1] >= x[1];
   forall(i in 2..N) s[i] >= x[i] - x[i-1];
   
   forall(i in I) sum(k in maxl(1, i-L+1)..i) s[k] <= x[i];
   
   forall(i in I: i >= N-L+2) s[i] == 0;
   
   forall(i in 1..N-U) sum(j in i..i+U) x[j] <= U;
   }
  
  execute {
    var start = 0;
    for (var i = 1; i <= N; i++){
      if(x[i] > 0.5 && (i == 1 || x[i-1] < 0.5)) start = i;
      if(x[i] > 0.5 && ( i == N || x [i+1] < 0.5)) writeln(start + " " + i);
      }
    }